{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "enterprise_data_context": {
      "type": "local",
      "command": [
        "/Users/fengyajie/.local/bin/uv",
        "run",
        "--isolated",
        "--directory",
        "/Users/fengyajie/Projects/data-agent-explore",
        "--extra",
        "dense",
        "data-context-mcp",
        "/Users/fengyajie/Projects/data-agent-explore/generated"
      ],
      "environment": {
        "DATA_CONTEXT_DENSE_LOCAL_ONLY": "1"
      },
      "enabled": true,
      "timeout": 120000
    }
  },
  "agent": {
    "explore": {
      "permission": {
        "enterprise_data_context_data_search": "allow",
        "enterprise_data_context_data_read": "allow",
        "enterprise_data_context_data_expand": "allow",
        "enterprise_data_context_data_source": "allow"
      }
    }
  }
}
