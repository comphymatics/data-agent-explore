{
  "name": "@data-agent/data-catalog",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "dist/mcp/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "context:build": "npm run build --silent && node dist/context-builder/cli.js",
    "context:build:dev": "tsx src/context-builder/cli.ts",
    "mock": "node dist/mock/server.js",
    "start": "node dist/mcp/index.js",
    "dev:mock": "tsx src/mock/server.ts",
    "dev:mcp": "tsx src/mcp/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "exceljs": "^4.4.0",
    "mammoth": "^1.10.0",
    "node-html-parser": "^7.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
