{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Retrieval Golden Evaluation Case",
  "type": "object",
  "required": [
    "case_id",
    "query"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "expected_contexts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "required_coverage": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "expected_missing": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "expected_anchors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "expected_elements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "relevant_contexts": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "expected_coverage": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "SATISFIED",
          "PARTIAL",
          "MISSING",
          "UNKNOWN"
        ]
      }
    },
    "expected_bindings": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "string"
        }
      }
    },
    "explore_options": {
      "type": "object"
    },
    "max_tool_calls": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "max_token_cost": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  },
  "additionalProperties": false
}
