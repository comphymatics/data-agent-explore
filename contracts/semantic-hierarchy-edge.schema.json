{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semantic-hierarchy-edge.schema.json",
  "title": "HierarchyEdge",
  "type": "object",
  "required": [
    "hierarchy_id",
    "parent_id",
    "child_id",
    "relation",
    "status",
    "confidence",
    "provenance",
    "evidence",
    "inference_version",
    "created_at"
  ],
  "properties": {
    "hierarchy_id": {
      "enum": [
        "analysis",
        "domain",
        "asset"
      ]
    },
    "parent_id": {
      "type": "string",
      "minLength": 1
    },
    "child_id": {
      "type": "string",
      "minLength": 1
    },
    "relation": {
      "const": "organized_under"
    },
    "status": {
      "enum": [
        "CONFIRMED",
        "DERIVED",
        "CANDIDATE"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "inference_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source"
        ],
        "properties": {
          "source": {
            "type": "object",
            "required": [
              "source_id",
              "path"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "method",
        "source_ids"
      ],
      "properties": {
        "method": {
          "enum": [
            "explicit",
            "domain_rule",
            "metadata_inference",
            "neighbor_inference",
            "llm_inference",
            "explicit_taxonomy"
          ]
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "input_facts": {
          "type": "array",
          "minItems": 1
        },
        "inference": {
          "type": "object",
          "required": [
            "candidate_set",
            "selected",
            "confidence",
            "supporting_features",
            "supporting_context_ids",
            "model",
            "prompt_version"
          ],
          "properties": {
            "candidate_set": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "selected": {
              "type": "string"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "supporting_features": {
              "type": "object"
            },
            "supporting_context_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "model": {
              "type": [
                "string",
                "null"
              ]
            },
            "prompt_version": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "CONFIRMED"
          }
        }
      },
      "then": {
        "properties": {
          "provenance": {
            "properties": {
              "method": {
                "enum": [
                  "explicit",
                  "explicit_taxonomy"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "DERIVED"
          }
        }
      },
      "then": {
        "properties": {
          "provenance": {
            "required": [
              "rule_id",
              "input_facts"
            ],
            "properties": {
              "method": {
                "const": "domain_rule"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "CANDIDATE"
          }
        }
      },
      "then": {
        "properties": {
          "provenance": {
            "required": [
              "inference"
            ],
            "properties": {
              "method": {
                "enum": [
                  "metadata_inference",
                  "neighbor_inference",
                  "llm_inference"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
