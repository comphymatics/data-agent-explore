{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/contracts/context-bundle.schema.json",
  "title": "Data Explore Context Bundle",
  "type": "object",
  "required": [
    "query",
    "summary",
    "primary_contexts",
    "analysis_context",
    "data_context",
    "business_mapping",
    "constraints",
    "environment",
    "coverage",
    "missing_context",
    "sources",
    "confidence",
    "conflicts",
    "candidates",
    "warnings",
    "truncated",
    "truncation_reasons",
    "index_version",
    "policy",
    "budget",
    "novelty",
    "selected_context_ids",
    "seen_context_ids",
    "exploration_state",
    "stop_reason",
    "reference_index_version",
    "binding_policy_version",
    "binding_overlay",
    "coverage_summary",
    "anchor_context_ids",
    "focused_expansion",
    "telemetry",
    "reasoning_observations",
    "serving"
  ],
  "properties": {
    "query": {
      "type": "object"
    },
    "summary": {
      "type": "string"
    },
    "primary_contexts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "type",
          "name",
          "relevance",
          "content_level",
          "content"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "relevance": {
            "type": "number"
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "content_level": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "L0",
              "L1",
              null
            ]
          },
          "content": {
            "type": [
              "string",
              "null"
            ]
          },
          "knowledge_layer": {
            "const": "REFERENCE"
          }
        },
        "additionalProperties": false
      }
    },
    "analysis_context": {
      "type": "object",
      "properties": {
        "hierarchy": {
          "$ref": "#/$defs/viewsByPath"
        },
        "relations": {
          "$ref": "#/$defs/viewsByPath"
        }
      }
    },
    "data_context": {
      "type": "object",
      "properties": {
        "hierarchy": {
          "$ref": "#/$defs/viewsByPath"
        },
        "relations": {
          "$ref": "#/$defs/viewsByPath"
        }
      }
    },
    "business_mapping": {
      "type": "object"
    },
    "constraints": {
      "type": "array"
    },
    "environment": {
      "type": "object"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "id",
          "entity",
          "entity_name",
          "aspect",
          "layer",
          "status",
          "evidence",
          "reason",
          "context_refs"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "entity": {
            "type": "string"
          },
          "entity_name": {
            "type": "string"
          },
          "aspect": {
            "enum": [
              "business_meaning",
              "purpose",
              "business_object",
              "metrics",
              "dimensions",
              "models",
              "fields",
              "grain",
              "lineage",
              "formula",
              "constraints",
              "attributes",
              "counters",
              "join_keys"
            ]
          },
          "layer": {
            "enum": [
              "REFERENCE",
              "ENVIRONMENT"
            ]
          },
          "status": {
            "enum": [
              "SATISFIED",
              "PARTIAL",
              "MISSING",
              "UNKNOWN",
              "NOT_APPLICABLE"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "reason": {
            "type": "string"
          },
          "context_refs": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
          "selector": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [{"if":{"properties":{"status":{"not":{"const":"UNKNOWN"}}}},"then":{"properties":{"evidence":{"minItems":1}}}}],
        "additionalProperties": false
      }
    },
    "missing_context": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "truncated": {
      "type": "boolean"
    },
    "truncation_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "index_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "reference_index_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "binding_policy_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "binding_overlay": {
      "type": "object",
      "required": [
        "environment_facts",
        "reference_semantics",
        "confirmed_bindings",
        "derived_bindings",
        "candidate_bindings",
        "reference_only_assets",
        "conflicts",
        "missing_context",
        "identity_bindings",
        "semantic_mappings",
        "structural_relations"
      ],
      "properties": {
        "binding_policy_version": {"const":"identity-binding/v3"},
        "environment_facts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "reference_semantics": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "confirmed_bindings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "derived_bindings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "candidate_bindings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "reference_only_assets": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "missing_context": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "identity_bindings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "semantic_mappings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "structural_relations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": [
        "intent",
        "required_coverage",
        "top_k",
        "bundle_k",
        "token_budget"
      ]
    },
    "budget": {
      "type": "object",
      "required": [
        "scope",
        "token_budget",
        "estimated_tokens",
        "remaining_tokens"
      ]
    },
    "novelty": {
      "type": "object",
      "required": [
        "candidate_count",
        "novel_candidate_count",
        "selected_new_count",
        "seen_skipped_count"
      ]
    },
    "selected_context_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "seen_context_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "exploration_state": {
      "type": "object",
      "required": [
        "index_version",
        "seen_context_ids",
        "coverage",
        "rounds",
        "used_tokens",
        "last_intent",
        "stop_reason"
      ],
      "properties": {
        "coverage": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "id",
              "entity",
              "entity_name",
              "aspect",
              "layer",
              "status",
              "evidence",
              "reason",
              "context_refs"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "entity": {
                "type": "string"
              },
              "entity_name": {
                "type": "string"
              },
              "aspect": {
                "enum": [
                  "business_meaning",
                  "purpose",
                  "business_object",
                  "metrics",
                  "dimensions",
                  "models",
                  "fields",
                  "grain",
                  "lineage",
                  "formula",
                  "constraints",
                  "attributes",
                  "counters",
                  "join_keys"
                ]
              },
              "layer": {
                "enum": [
                  "REFERENCE",
                  "ENVIRONMENT"
                ]
              },
              "status": {
                "enum": [
                  "SATISFIED",
                  "PARTIAL",
                  "MISSING",
                  "UNKNOWN",
                  "NOT_APPLICABLE"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "reason": {
                "type": "string"
              },
              "context_refs": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
              "selector": {
                "type": "string",
                "minLength": 1
              }
            },
            "allOf": [{"if":{"properties":{"status":{"not":{"const":"UNKNOWN"}}}},"then":{"properties":{"evidence":{"minItems":1}}}}],
            "additionalProperties": false
          }
        },
        "query_signature": {
          "type": [
            "string",
            "null"
          ]
        },
        "environment_snapshot": {
          "type": [
            "string",
            "null"
          ]
        },
        "serving_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "stop_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "coverage_summary": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "anchor_context_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "focused_expansion": {
      "type": "object"
    },
    "telemetry": {
      "type": "object",
      "required": [
        "tool_calls",
        "total_tool_calls",
        "total_tokens_estimated",
        "semantic_calls"
      ]
    },
    "reasoning_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "excerpt",
          "knowledge_layer",
          "evidence"
        ]
      }
    },
    "serving": {
      "type": "object",
      "required": [
        "retrieval_version",
        "encoder_version",
        "coverage_version"
      ]
    },
    "retrieval_trace": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "direct",
            "hierarchical",
            "hybrid"
          ]
        },
        "hierarchy_view": {
          "enum": [
            "analysis",
            "domain",
            "asset",
            null
          ]
        },
        "selected_branches": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hierarchy_contexts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  },
  "$defs": {
    "viewsByPath": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false
}
